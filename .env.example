# ==============================================================================
# RazorChain AI - Environment Configuration Template
# Copy this file to .env and fill in the values for your local or production setup.
# ==============================================================================

# PostgreSQL Database Connection
# Example: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="postgresql://razorchain:razorchain_dev@localhost:5432/razorchain_ai"

# Google Gemini API Key(s) for AI Document Discrepancy & KYB Verification Agents
# Single Key:
GOOGLE_API_KEY="your_gemini_api_key_here"
# Optional Multi-Key Pool (comma-separated for key rotation & quota balancing):
# GOOGLE_API_KEYS="key_1,key_2,key_3"

# Razorpay Payment Integration
# Payment provider toggle: 'razorpay' for live/test Razorpay API, or 'mock' for simulated sandbox
RAZORCHAIN_PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID="rzp_test_your_key_id_here"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"

# NextAuth / Session Secret & App URL
NEXTAUTH_SECRET="replace-with-a-secure-random-32-character-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional Cron & Webhook API Security Keys
# CRON_SECRET="your-cron-secret-for-escrow-timers"
# RAZORCHAIN_API_KEY="your-inbound-purchase-order-api-key"
