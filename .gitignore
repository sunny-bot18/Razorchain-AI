# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build & static export
/.next/
/out/
/build
/dist

# Testing & Coverage
/coverage
*.lcov

# Environment files (always ignore actual env files, keep example template)
.env
.env*.local
.env.development
.env.test
.env.production
.env*
!.env.example

# Dynamic user uploads & temporary files
/uploads/*
!/uploads/.gitkeep
/tmp/*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Debug and error logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel deployment metadata
.vercel

# Security credentials & private keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# OS metadata files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
